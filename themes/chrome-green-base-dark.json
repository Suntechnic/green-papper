				"scope": "entity.name.type, support.type, storage.type",
				"settings": {
					"foreground": "#82c7c4"
				}
			},
			{
				"scope": "keyword, storage, keyword.control",
				"settings": {
					"foreground": "#d48aa5",
					"fontStyle": "bold"
				}
			},
			{
				"scope": "string, punctuation.definition.string",
				"settings": {
					"foreground": "#b9d88f"
				}
			},
			{
				"scope": "variable, variable.parameter",
				"settings": {
					"foreground": "#d8d6b8"
				}
			},
			{
				"scope": "entity.name.tag, entity.other.attribute-name",
				"settings": {
					"foreground": "#e0a27e"
				}
			}
