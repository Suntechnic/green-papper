	{
		"name": "Green Chrome Dark: base",
		"include": "./token-colors/base.json",
		"tokenColors": [
			{
				"scope": "comment",
				"settings": {
					"foreground": "#82958a",
					"fontStyle": "italic"
				}
			},
			{
				"scope": "constant, constant.numeric",
				"settings": {
					"foreground": "#d6a86b"
				}
			},
			{
				"scope": "entity.name.function, support.function",
				"settings": {
					"foreground": "#8fd1a1"
				}
