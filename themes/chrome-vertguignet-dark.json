{
  "name": "Vert Guignet Chrome Dark",
  "include": "./token-colors/base.json",
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#9da299",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "constant, constant.other",
      "settings": {
        "foreground": "#ae8252"
      }
    },
    {
      "scope": "constant.numeric, constant.language",
      "settings": {
        "foreground": "#c394e8"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call",
      "settings": {
        "foreground": "#a0d490"
      }
    },
    {
      "scope": "entity.name.type, support.type, storage.type",
      "settings": {
        "foreground": "#c57636"
      }
    },
    {
      "scope": "support.class, entity.name.type.class, entity.name.type.namespace, entity.name.class, entity.name.class.identifier.namespace.type",
      "settings": {
        "foreground": "#87b2bd"
      }
    },
    {
      "scope": "keyword, storage, keyword.control, keyword.operator",
      "settings": {
        "foreground": "#d7945e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "string, punctuation.definition.string, markup.inline.raw",
      "settings": {
        "foreground": "#f07171"
      }
    },
    {
      "scope": "variable, variable.other.property",
      "settings": {
        "foreground": "#edf0d2"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#e4c382"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5ba3ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "entity.name.tag, entity.other.attribute-name, markup.heading, markup.bold, markup.italic",
      "settings": {
        "foreground": "#f3c69b"
      }
    },
    {
      "scope": "meta.embedded, source.php, text.html.php",
      "settings": {
        "foreground": "#e0e4da"
      }
    },
    {
      "scope": "entity.name.tag.html, punctuation.definition.tag.begin.html, punctuation.definition.tag.end.html",
      "settings": {
        "foreground": "#7cacf8"
      }
    },
    {
      "scope": "entity.other.attribute-name.html",
      "settings": {
        "foreground": "#a8c7fa"
      }
    },
    {
      "scope": "string.quoted.double.html, string.quoted.single.html",
      "settings": {
        "foreground": "#fe8d59"
      }
    },
    {
      "scope": "punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.separator.key-value.html",
      "settings": {
        "foreground": "#7cacf8"
      }
    },
    {
      "scope": "entity.other.attribute-name.html[href], entity.other.attribute-name.html[src]",
      "settings": {
        "foreground": "#a0d490"
      }
    },
    {
      "scope": "support.type.vendored.property-name.css, meta.property-name.css",
      "settings": {
        "foreground": "#5dd5fb"
      }
    },
    {
      "scope": "meta.property-value.css, support.constant.property-value.css",
      "settings": {
        "foreground": "#e0e4da"
      }
    },
    {
      "scope": "variable.other.readwrite.js, support.variable.property.js, support.variable.object.process.js, variable.other.readwrite.ts, support.variable.property.ts",
      "settings": {
        "foreground": "#8cc27e"
      }
    },
    {
      "scope": "meta.object-literal.key.js, meta.object-literal.key.ts",
      "settings": {
        "foreground": "#8cc27e"
      }
    },
    {
      "scope": "support.type.object.console.js, support.type.object.console.ts, support.variable.dom.js, support.variable.property.dom.js, support.variable.dom.ts, support.variable.property.dom.ts",
      "settings": {
        "foreground": "#8cc27e"
      }
    },
    {
      "scope": "punctuation.definition.template-expression.begin.js, punctuation.definition.template-expression.end.js, punctuation.definition.template-expression.begin.ts, punctuation.definition.template-expression.end.ts",
      "settings": {
        "foreground": "#8cc27e"
      }
    },
    {
      "scope": "keyword.operator.expression.instanceof.js, keyword.operator.expression.instanceof.ts, keyword.operator.expression.typeof.js, keyword.operator.expression.typeof.ts",
      "settings": {
        "foreground": "#8cc27e"
      }
    },
    {
      "scope": "var.this.js, var.this.ts, variable.language.this.js, variable.language.this.ts",
      "settings": {
        "foreground": "#5ba3ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "text.html.markdown, meta.paragraph.markdown, markup.paragraph.markdown, punctuation.definition.list.markdown",
      "settings": {
        "foreground": "#e0e4da"
      }
    },
    {
      "scope": "markup.heading, markup.heading entity.name, markup.heading.markdown, entity.name.section.markdown, punctuation.definition.heading.markdown",
      "settings": {
        "foreground": "#e4c382",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.list, markup.quote, markup.italic, markup.bold, markup.underline, markup.link, markup.raw",
      "settings": {
        "foreground": "#b8c47f"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#86b875"
      }
    }
  ],
