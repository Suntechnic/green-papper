{
  "name": "Vert Guignet Chrome Dark",
  "include": "./token-colors/main.json",
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#c1c8b8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "constant, constant.numeric, constant.language",
      "settings": {
        "foreground": "#f4d19b"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call",
      "settings": {
        "foreground": "#a9efbb"
      }
    },
    {
      "scope": "entity.name.type, support.type, storage.type, support.class",
      "settings": {
        "foreground": "#a6dfff"
      }
    },
    {
      "scope": "support.class, entity.name.type.class, entity.name.type.namespace, entity.name.class, entity.name.class.identifier.namespace.type",
      "settings": {
        "foreground": "#bfe6ff"
      }
    },
    {
      "scope": "keyword, storage, keyword.control, keyword.operator",
      "settings": {
        "foreground": "#ffc4d6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "string, punctuation.definition.string, markup.inline.raw",
      "settings": {
        "foreground": "#dff7a5"
      }
    },
    {
      "scope": "variable, variable.parameter, variable.other.property",
      "settings": {
        "foreground": "#f0f4db"
      }
    },
    {
      "scope": "entity.name.tag, entity.other.attribute-name, markup.heading, markup.bold, markup.italic",
      "settings": {
        "foreground": "#f2c992"
      }
    },
    {
      "scope": "meta.embedded, source.php, text.html.php",
      "settings": {
        "foreground": "#edf7ff"
      }
    },
    {
      "scope": "string.quoted.double.html, string.quoted.single.html",
      "settings": {
        "foreground": "#eef7c8"
      }
    },
    {
      "scope": "text.html.markdown, meta.paragraph.markdown, punctuation.definition.list.markdown",
      "settings": {
        "foreground": "#f2ede0"
      }
    },
    {
      "scope": "markup.heading, markup.heading entity.name, markup.heading.markdown, entity.name.section.markdown, punctuation.definition.heading.markdown",
      "settings": {
        "foreground": "#ffe6bf",
        "fontStyle": "bold"
      }
    }
  ],
