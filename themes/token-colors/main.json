{
    "include": "./base.json",
	"tokenColors": [
		{
			"name": "Variables",
			"scope": "variable",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#006600"
			}
		},
        {
			"name": "String",
			"scope": "string | punctuation.definition.string",
			"settings": {
				"foreground": "#cc33cc"
			}
		},

		{
			"name": "Strings, Inherited Class",
			"scope": "string, entity.other.inherited-class",
			"settings": {
				"foreground": "#cc33cc"
			}
		}
	]
}
